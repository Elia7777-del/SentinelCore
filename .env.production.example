# SentinelCore production configuration
# Replace every placeholder. Never commit the real .env.production file.

APP_ENV=production
SECRET_KEY=REPLACE_WITH_64_BYTE_RANDOM_SECRET
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
DATABASE_URL=postgresql://sentinelcore:REPLACE_WITH_LONG_RANDOM_PASSWORD@db:5432/sentinelcore

# Public API URL, e.g. https://security.example.com
PUBLIC_API_URL=https://REPLACE_WITH_YOUR_DOMAIN

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REQUIRE_MFA=true

# Audit / retention
AUDIT_RETENTION_DAYS=365
EVENT_RETENTION_DAYS=90

# Response safety
DEFAULT_RESPONSE_MODE=approval_required
ALLOW_AUTOMATIC_CONTAINMENT=false
